# Copy to .env and fill in for local (non-docker-compose) runs. See
# mirage_ai/settings.py for the Settings this loads into and its defaults —
# docker-compose.yml sets these directly as container env vars instead of
# reading a .env file, so this is mainly useful for `uvicorn --reload` runs
# against a manually-started Postgres.

# SQLAlchemy database URL for session-state persistence (see store.py).
AI_DATABASE_URL=postgresql+psycopg://mirage:mirage@localhost:5432/mirage

# Comma-separated browser origins allowed to call this API directly.
# In the real architecture only backend/ talks to ai/ (server-to-server,
# no Origin header, so CORS doesn't apply there) — this only matters if
# you're hitting ai/ directly from a browser for local testing.
AI_CORS_ORIGINS=http://localhost:8001

# "development" (default) exposes /docs, /redoc, /openapi.json.
# "production" disables all three.
AI_ENVIRONMENT=development

# Sentry error-tracking DSN. Empty (default) disables Sentry entirely —
# no network calls, no dependency on a Sentry project existing.
AI_SENTRY_DSN=
