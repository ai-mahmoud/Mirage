# Copy to .env and fill in for local (non-docker-compose) runs. See
# mirage_backend/config.py for the Config this loads into and its
# defaults — docker-compose.yml sets these directly as container env vars
# instead of reading a .env file, so this is mainly useful for
# `uvicorn --reload` runs against a manually-started Postgres/ai process.

# Base URL of the ai/ FastAPI process this service proxies to.
AI_SERVICE_URL=http://localhost:8000

# SQLAlchemy database URL for session/org/user persistence.
BACKEND_DATABASE_URL=postgresql+psycopg://mirage:mirage@localhost:5432/mirage

# Directory generated PDF reports are written to.
BACKEND_REPORTS_DIR=reports

# HMAC key signing/verifying JWTs (see mirage_backend/auth.py). The
# in-code default is a fixed, publicly-known placeholder — MUST be
# overridden to a real secret before this is ever exposed to real users;
# anyone with the default can forge tokens for any account.
BACKEND_JWT_SECRET=change-me-to-a-long-random-value

# Comma-separated browser origins allowed to call this API (the
# frontend's real origin(s) — the default covers local dev + the GitHub
# Pages demo deployment).
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://ai-mahmoud.github.io

# "development" (default) exposes /docs, /redoc, /openapi.json.
# "production" disables all three.
BACKEND_ENVIRONMENT=development
